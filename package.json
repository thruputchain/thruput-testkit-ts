{
  "name": "@thruputchain/testkit",
  "version": "0.1.0",
  "description": "Thruput application scenarios for Node.js tests and scripts",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thruputchain/thruput-testkit-ts.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none",
    "test": "vitest run && node --test scripts/integration-config.test.mjs",
    "test:smoke": "node tests/consumer-smoke.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:integration": "npm run build && node scripts/run-integration.mjs",
    "example:transfer": "tsx examples/01-local-transfer.ts",
    "example:counter": "tsx examples/02-deploy-counter.ts",
    "example:deploy": "tsx examples/03-deployment-run.ts",
    "example:reconcile": "tsx examples/04-reconcile-run.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@thruputchain/client": "^0.26.0"
  },
  "devDependencies": {
    "@thruputchain/client": "file:.local-packages/thruputchain-client-0.26.0.tgz",
    "@thruputchain/contract-spec": "0.20.0",
    "@thruputchain/protocol": "0.20.0",
    "@types/node": "25.9.1",
    "prettier": "3.8.3",
    "tsdown": "0.22.2",
    "tsx": "^4.23.15",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
